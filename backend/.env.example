# Backend Environment Configuration Example
# Copy this file to .env and modify as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# CORS Configuration
CORS_ORIGINS=*

# Simulation Configuration
SIMULATION_TIME_STEP_NS=1000000  # 1ms per step
SIMULATION_UPDATE_RATE_MS=50     # Update every 50ms

# Logging Configuration
LOG_LEVEL=INFO
